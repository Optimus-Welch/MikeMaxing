# Copy to `.env` and fill in if you want to point at a different Supabase
# project. Both values are optional — src/lib/supabaseConfig.js already
# defaults to the project this app was built for.
#
# ONLY publishable values belong here. Vite inlines every VITE_* variable into
# the built JavaScript, so anything in this file is public. The service_role
# key (or any sb_secret_* key) must never appear here, in CI, or in the repo:
# it bypasses row-level security entirely.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
